# =============================================================================
# Copy this file to `.env.local`, then replace EVERY value below.
# Anything left as `…_xxx` will be rejected by the app at runtime.
# Restart `npm run dev` after editing.
# =============================================================================

# ---------- Clerk (auth) ----------
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat

# ---------- Convex (database) ----------
# Get this from `npx convex dev` (printed once, also visible in the Convex
# dashboard under Settings → URL).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Shared secret used for the Stripe webhook → Convex action call.
# Pick anything random; set the SAME value in Convex with:
#   npx convex env set WEBHOOK_INTERNAL_SECRET <value>
WEBHOOK_INTERNAL_SECRET=change-me-please

# ---------- Stripe (billing) ----------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe → Developers → Webhooks → Add endpoint
#   URL:    {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
#   Events: checkout.session.completed,
#           customer.subscription.{created,updated,deleted},
#           invoice.{payment_succeeded,payment_failed}
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- Stripe Price IDs ----------
# Create RECURRING (monthly) prices for each plan in Stripe → Products,
# then paste the resulting `price_…` IDs here. Real Stripe price IDs always
# start with `price_` and are ~24 characters long.
#
# DO NOT leave the `price_xxx` placeholders below — the checkout route will
# refuse to start and tell the user the env var is unset.
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BASIC_USD=price_xxx
STRIPE_PRICE_STARTER_USD=price_xxx
STRIPE_PRICE_PRO_USD=price_xxx
STRIPE_PRICE_BASIC_GBP=price_xxx
STRIPE_PRICE_STARTER_GBP=price_xxx
STRIPE_PRICE_PRO_GBP=price_xxx

# Create ONE-TIME prices for each credit add-on:
STRIPE_PRICE_CREDITS_5K=price_xxx
STRIPE_PRICE_CREDITS_10K=price_xxx
STRIPE_PRICE_CREDITS_25K=price_xxx
STRIPE_PRICE_CREDITS_50K=price_xxx
STRIPE_PRICE_CREDITS_5K_USD=price_xxx
STRIPE_PRICE_CREDITS_10K_USD=price_xxx
STRIPE_PRICE_CREDITS_25K_USD=price_xxx
STRIPE_PRICE_CREDITS_50K_USD=price_xxx
STRIPE_PRICE_CREDITS_5K_GBP=price_xxx
STRIPE_PRICE_CREDITS_10K_GBP=price_xxx
STRIPE_PRICE_CREDITS_25K_GBP=price_xxx
STRIPE_PRICE_CREDITS_50K_GBP=price_xxx

# ---------- OpenRouter (AI gateway) ----------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Vercilio

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Currency ----------
# Used to convert Stripe EUR charges into USD-priced contribution unit costs.
EUR_USD_RATE=1.08

# ---------- Admin ----------
# Comma-separated Clerk user IDs (look like `user_2abc…`) granted admin
# access to /admin. Leave empty for none.
ADMIN_USER_IDS=
